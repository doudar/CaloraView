{
  "name": "caloraview-desktop",
  "version": "0.1.0",
  "description": "Desktop thermal imaging, temperature measurement and recording for AccuMEMS SK02 cameras",
  "main": "src/main.cjs",
  "author": "Caloraview Desktop contributors",
  "private": true,
  "scripts": {
    "prestart": "node scripts/build-controls.cjs",
    "prepack": "node scripts/build-controls.cjs",
    "predist:win": "node scripts/build-controls.cjs",
    "start": "electron .",
    "test": "node --test test/*.test.cjs",
    "test:ui": "node scripts/ui-smoke.cjs",
    "pack": "electron-builder --dir",
    "dist:win": "electron-builder --win nsis",
    "dist:mac": "electron-builder --mac pkg",
    "check:repo": "node scripts/check-repository.cjs"
  },
  "dependencies": {
    "ffmpeg-static": "5.3.0",
    "onnxruntime-node": "1.31.1"
  },
  "devDependencies": {
    "electron": "45.3.0",
    "electron-builder": "26.18.0",
    "playwright": "1.65.0"
  },
  "build": {
    "appId": "local.caloraview.desktop",
    "productName": "Caloraview Desktop",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "LICENSE",
      "package.json",
      "node_modules/ffmpeg-static/**/*"
    ],
    "asarUnpack": [
      "node_modules/ffmpeg-static/ffmpeg*",
      "node_modules/onnxruntime-node/bin/**/*"
    ],
    "win": {
      "target": "nsis",
      "icon": "assets/brand/icon.ico",
      "extraResources": [
        {
          "from": "build/native",
          "to": "native",
          "filter": [
            "Caloraview.CameraControl.exe"
          ]
        }
      ],
      "files": [
        "src/**/*",
        "LICENSE",
        "package.json",
        "node_modules/ffmpeg-static/**/*",
        "!node_modules/onnxruntime-node/bin/napi-v6/darwin/**/*",
        "!node_modules/onnxruntime-node/bin/napi-v6/linux/**/*"
      ]
    },
    "mac": {
      "target": "pkg",
      "category": "public.app-category.utilities",
      "icon": "assets/brand/icon.icns",
      "extendInfo": {
        "NSCameraUsageDescription": "Caloraview reads your USB thermal camera to display and record thermal frames."
      },
      "files": [
        "src/**/*",
        "LICENSE",
        "package.json",
        "node_modules/ffmpeg-static/**/*",
        "!node_modules/onnxruntime-node/bin/napi-v6/win32/**/*",
        "!node_modules/onnxruntime-node/bin/napi-v6/linux/**/*"
      ]
    },
    "afterPack": "scripts/verify-package.cjs",
    "artifactName": "Caloraview-Desktop-${version}-${os}-${arch}.${ext}",
    "nsis": {
      "artifactName": "Caloraview-Desktop-${version}-win-${arch}-Setup.${ext}",
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "deleteAppDataOnUninstall": false
    },
    "pkg": {
      "artifactName": "Caloraview-Desktop-${version}-mac-${arch}-Installer.${ext}",
      "installLocation": "/Applications",
      "allowAnywhere": false,
      "allowCurrentUserHome": false,
      "allowRootDirectory": true
    }
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/doudar/CaloraView.git"
  },
  "homepage": "https://github.com/doudar/CaloraView#readme",
  "bugs": {
    "url": "https://github.com/doudar/CaloraView/issues"
  },
  "engines": {
    "node": ">=22"
  }
}
